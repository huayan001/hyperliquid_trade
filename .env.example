# Hyperliquid 凭证：只放环境变量，切勿提交真实密钥。
# 默认 dry-run 不需要填写下面两项；拉取公开行情即可。

# 主网或测试网钱包私钥（API Wallet 私钥也可）
# HL_PRIVATE_KEY=0x...

# 主账户地址。若使用 API Wallet / Agent 签名，必须填主账户地址，而不是 API Wallet 地址。
# HL_ACCOUNT_ADDRESS=0x...

# mainnet | testnet
HL_NETWORK=mainnet

# true=模拟盘（默认，只打印意图不下单）
HL_DRY_RUN=true

# 实盘总开关。必须同时满足：HL_DRY_RUN=false + HL_ENABLE_LIVE=1 + CLI --live
# HL_ENABLE_LIVE=0

# 无真实账户时的模拟权益（USD）
HL_PAPER_EQUITY=10000

# 可选：覆盖默认标的（逗号分隔）
# HL_SYMBOLS=BTC,ETH,SOL,HYPE

# 可选：配置文件路径
# HL_CONFIG=config.toml

# 统一目标杠杆（所有交易对开仓前 updateLeverage）
# HL_LEVERAGE=10

# 单笔风险占权益比例（同时覆盖趋势/均值回归 risk_pct）
# HL_RISK_PCT=0.02

# 止损相对入场的最大距离系数：≤ (1/杠杆)*该值，防止强平抢在止损前
# HL_LIQ_BUFFER_FRAC=0.50

